# ======================================================================
#  Contract Assessment Tools – server settings  (KEY=VALUE, one per line)
#  The installers copy this to cat.env and fill in the paths for you.
# ======================================================================

# --- network -----------------------------------------------------------
# Address and port the server listens on (0.0.0.0 = all network cards)
CAT_HOST=0.0.0.0
CAT_PORT=8000
# HTTPS directly from this server (optional – or use a reverse proxy / load balancer)
# CAT_SSL_CERT=/path/to/certificate.pem
# CAT_SSL_KEY=/path/to/private-key.pem
# Set to 1 when users reach the site over HTTPS through a proxy (secure cookies)
CAT_COOKIE_SECURE=0
# Proxy addresses allowed to pass the real client IP (X-Forwarded-For)
CAT_TRUSTED_PROXIES=127.0.0.1

# --- storage -----------------------------------------------------------
# Folder for uploaded originals, nightly backups (and the SQLite database if used)
CAT_DATA_DIR=./data
# Database: leave empty for SQLite in CAT_DATA_DIR (single server, small teams),
# or PostgreSQL 13+ for production:
# DATABASE_URL=postgresql+psycopg://cat:PASSWORD@db-server:5432/cat
DATABASE_URL=

# --- operation -----------------------------------------------------------
CAT_SESSION_HOURS=12
CAT_MAX_UPLOAD_MB=50
CAT_BACKUP_HOUR=2
CAT_BACKUP_KEEP=14
# CAT_LOG_FILE=./data/logs/server.log

# Load the sample project into an EMPTY database at first start (0 for production)
SEED_SAMPLE=1
SAMPLE_PASSWORD=Sample-2026-demo

# --- optional integrations ---------------------------------------------
# Claude API key, kept on the server (AI stays off until each company authorises it)
ANTHROPIC_API_KEY=
# E-mail for scheduled KPI summaries
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cat-reports@your-company.ae
SMTP_TLS=1
